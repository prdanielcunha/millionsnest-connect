# Optional legacy/demo AI configuration. Keep credentials server-side only.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# Server-side canonical ecosystem origins used by Connect Core adapters.
# These are origins only (scheme + host), never credentials or API keys.
MILLIONSNEST_HUB_ORIGIN="https://www.millionsnest.com"
MUSICSCALE_ORIGIN="https://musicscale.millionsnest.com"

# Live in-app rollout gate. Leave false until Hub handoff + Connect Core are
# certified in the target environment. When false, the existing DEMO_MODE UI
# remains unchanged.
VITE_CONNECT_LIVE_ENABLED="false"

# Optional development override only. In Firebase Hosting the live bootstrap
# reads the public Firebase web config from /__/firebase/init.json, so no API
# key needs to be committed to this repository.
VITE_FIREBASE_API_KEY=""

# Optional legacy/demo AI configuration. Keep credentials server-side only.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# Server-side canonical ecosystem origins used by Connect Core adapters.
# These are origins only (scheme + host), never credentials or API keys.
MILLIONSNEST_HUB_ORIGIN="https://www.millionsnest.com"
MUSICSCALE_ORIGIN="https://musicscale.millionsnest.com"

# Live in-app rollout gate. Leave false until Hub handoff + Connect Core are
# certified in the target environment. When false, the existing DEMO_MODE UI
# remains unchanged.
VITE_CONNECT_LIVE_ENABLED="false"

# Optional development override only. In Firebase Hosting the live bootstrap
# reads the public Firebase web config from /__/firebase/init.json, so no API
# key needs to be committed to this repository.
VITE_FIREBASE_API_KEY=""
# Public Firebase Web API key used server-side only to exchange Hub-issued
# identity-only custom tokens for short-lived Firebase ID tokens. Not a secret.
CONNECT_FIREBASE_API_KEY=""
CONNECT_PUBLIC_ORIGIN="https://connect.millionsnest.com"

# Durable organizational Inbox backend gate. Keep false until the dedicated
# Connect runtime IAM role is bound and /api/health/storage-readiness proves
# read_write_confirmed. This does not control the historical DEMO_MODE UI.
CONNECT_INBOX_DURABLE_ENABLED="false"
CONNECT_INBOX_MESSAGE_CONTENT_ENABLED="false"

# Official Meta WhatsApp Business Platform. Secrets must stay server-side.
# Production activation is performed only by the gated WhatsApp activation
# workflow after all provider values and the tenant binding are present.
CONNECT_WHATSAPP_WEBHOOK_ENABLED="false"
CONNECT_WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
CONNECT_WHATSAPP_APP_SECRET=""
CONNECT_WHATSAPP_ACCESS_TOKEN=""
CONNECT_WHATSAPP_GRAPH_API_VERSION=""
CONNECT_WHATSAPP_PHONE_NUMBER_ID=""
CONNECT_WHATSAPP_WABA_ID=""
CONNECT_WHATSAPP_CONNECTIONS_JSON="[]"
CONNECT_WHATSAPP_INGESTION_ENABLED="false"
CONNECT_INBOX_HUMAN_REPLY_ENABLED="false"
CONNECT_WHATSAPP_PROVIDER_DISPATCH_ENABLED="false"
CONNECT_WHATSAPP_REPLY_POLICY_ACK=""
# Automatic known-intent bridge: WhatsApp -> Hub identity/RBAC -> Connect Core
# -> MusicScale Tool Gateway -> official WhatsApp response.
CONNECT_WHATSAPP_ASSIST_ENABLED="false"
